# Normalise line endings on commit, keep LF in the repo
* text=auto eol=lf

*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.xml  text eol=lf
*.json text eol=lf
*.svg  text eol=lf

# Never touch binary media
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.mp4  binary
*.webm binary
*.woff2 binary
*.woff binary